# SMTP details from your email provider. Never share this file publicly.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mail@example.com
SMTP_PASS=your-app-password
MAIL_FROM=Exxpress <your-mail@example.com>
PORT=8000

# Add the real key only in Render Environment, never in this file
GEMINI_API_KEY=

# Optional: low-latency Gemini model used by EXXPRESS support
GEMINI_MODEL=gemini-3.5-flash-lite
